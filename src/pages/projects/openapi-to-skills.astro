<script>
  document.addEventListener("DOMContentLoaded", () => {
    /* ── Copy button ── */
    document.querySelectorAll(".qs-copy").forEach((btn) => {
      btn.addEventListener("click", () => {
        navigator.clipboard.writeText(btn.dataset.copy ?? "").then(() => {
          const label = btn.querySelector(".qs-copy-label");
          btn.classList.add("qs-copy--ok");
          if (label) label.textContent = "Copied!";
          setTimeout(() => {
            btn.classList.remove("qs-copy--ok");
            if (label) label.textContent = "Copy";
          }, 2000);
        });
      });
    });

    /* ── Hero slot rotation ── */
    const track = document.querySelector<HTMLElement>(".sub-slot-track");
    if (track) {
      const items = track.querySelectorAll(".sub-slot-item");
      const count = items.length;
      // Clone first item to the end for seamless loop
      track.appendChild(items[0].cloneNode(true));
      let current = 0;
      setInterval(() => {
        current++;
        track.style.transition = "transform 0.45s cubic-bezier(0.4, 0, 0.2, 1)";
        track.style.transform = `translateY(calc(-${current} * 1.5em))`;
        // After reaching the clone, silently reset to real item 0
        if (current === count) {
          setTimeout(() => {
            track.style.transition = "none";
            track.style.transform = "translateY(0)";
            current = 0;
          }, 480);
        }
      }, 2200);
    }

    /* ── Scroll Reveal ── */
    const reveals = document.querySelectorAll(".reveal");
    const revealObs = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("revealed");
            revealObs.unobserve(e.target);
          }
        });
      },
      { threshold: 0.08, rootMargin: "0px 0px -32px 0px" }
    );
    reveals.forEach((el) => revealObs.observe(el));

  });
</script>

