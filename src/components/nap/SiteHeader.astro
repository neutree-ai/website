---
// The site's chrome, wearing the site's clothes but carrying this product's
// links: Docs and GitHub here mean NAP's docs and NAP's repo, not Neutree's.
import GitHubMark from './GitHubMark.astro'
---

<header class="site">
  <div class="wrap site-inner">
    <a class="mark" href="/">
      <img src="/images/neutree-logo-shape.svg" alt="" class="mark-shape" />
      <img src="/images/neutree-logo-text.svg" alt="Neutree" class="mark-text" />
      <span class="mark-sep" aria-hidden="true"></span>
      <span class="mark-product">NAP</span>
    </a>
    <nav class="top">
      <a href="https://nap.neutree.ai/docs/">Docs</a>
      <a href="#start">Install</a>
      <a
        href="https://github.com/neutree-ai/agent-platform"
        class="nav-gh"
        aria-label="GitHub"
        target="_blank"
        rel="noopener noreferrer"
      >
        <GitHubMark />
      </a>
    </nav>
  </div>
</header>
