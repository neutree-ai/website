---
// A landing page that carries its own design system: its own tokens, type
// scale and reset. It deliberately does NOT use Layout.astro, whose global
// reset and Figma tokens would fight this page's own; what is shared is the
// repo, the stack, the deploy pipeline and the shape of the metadata.
interface Props {
  title: string
  description: string
  ogImage?: string
}

const { title, description, ogImage = '/images/nap-og-image.png' } = Astro.props

const siteUrl = import.meta.env.SITE || ''
const imageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:site_name" content="Neutree" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:opsz,wght@9..40,400..800&family=Gabarito:wght@400..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
